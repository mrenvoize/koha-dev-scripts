#!/usr/bin/env bash
# kd — Koha dev workflow wrapper
# Manages git worktrees and KTD instances for Koha feature development.

set -e

# Absolute path to this script, used by 'kd list' to re-invoke itself for
# fzf's reload bindings regardless of how it was originally launched
# (PATH lookup, symlink, relative path, ...).
KD_SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
readonly KD_SELF
readonly KD_TITLE_WIDTH=60

# ── helpers ───────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF

kd — Koha dev workflow wrapper

Usage:
    kd up  <name> [--plugin PATH] [--plugins] [--search-engine ENGINE]
                  [--selenium] [--smtp] [--sso] [--persistent-db] [--bz] [--tmux] [--track UPSTREAM]
                  [--non-interactive] [--follow-status STATUS]
    kd wt  <name> [--bz] [--track UPSTREAM] [--non-interactive] [--follow-status STATUS]
    kd down <name> [--keep] [--rm=full]
    kd tmux <name>
    kd shell <name> [--root] [--run 'cmd']
    kd logs <name>
    kd list [--refresh]
    kd prune [--older-than DAYS] [--no-containers] [-n|--dry-run] [-y|--yes]
    kd proxy [start|stop|status]
    kd -h|--help

Commands:
    up        Create worktree (if needed) and start a KTD instance; --bz applies the
              bug's patches before booting; --tmux waits for KTD then opens tmux;
              --track UPSTREAM creates branch tracking an upstream ref (e.g. origin/master);
              with --bz, --non-interactive / --follow-status STATUS are passed to
              git bz apply (for unattended use; exit status is git bz's own)
    wt        Create worktree only (no KTD); --bz applies the bug's patches;
              --track UPSTREAM creates branch tracking an upstream ref (e.g. origin/master)
    down      Stop a KTD instance and remove its worktree (branch is kept;
              --keep leaves the worktree in place; --rm=full also deletes the branch)
    tmux      Attach or create a tmux dev session for the feature
    shell     Drop into the KTD container shell
    logs      Follow the KTD container logs
    list      Table of local branches with their Bugzilla title/status,
              last-worked date, and worktree/container status; --refresh
              forces a fresh Bugzilla lookup. Opens in fzf when available
              (alt-t/b/l/c sort by title/bz/last-worked/container, alt-r
              resets to branch order); otherwise falls back to $PAGER.
              In fzf, enter opens an action menu for the row (tab selects
              several for bulk up/down); ctrl-t = tmux, ctrl-u = up (and
              open tmux), ctrl-d = down. The list refreshes after each action.
    prune     Remove worktrees nothing is using any more, and the KTD containers
              left behind without one. A worktree is removed only if it is clean
              (or an abandoned half-applied git am), idle for --older-than days
              (default 7), has no running KTD instance and no process with its
              cwd inside. Branches are never deleted. Lists what it will do and
              asks first; -n only lists, -y skips the question, --no-containers
              leaves orphaned KTD instances alone
    proxy     Manage the shared Traefik proxy (start|stop|status)

Environment:
    KOHA_DIR    Root of the Koha workspace (default: ~/Projects/koha)
    KTD_HOME    KTD checkout (default: \$KOHA_DIR/tooling/koha-testing-docker)
    KD_AGENT    Agent CLI for kd tmux's dev window (default: claude; e.g. opencode, vibe)

EOF
}

setup_env() {
    export KOHA_DIR="${KOHA_DIR:-$HOME/Projects/koha}"
    export KTD_HOME="${KTD_HOME:-$KOHA_DIR/tooling/koha-testing-docker}"
    export LOCAL_USER_ID="$(id -u)"
    export LOCAL_GROUP_ID="$(id -g)"
}

# Converts a branch name to a Docker-safe project name and exports KOHA_IMAGE.
# Versioned branches (NN.NN.TAG, e.g. 24.11.etf) → TAG+MAJOR (etf24), KOHA_IMAGE=24.11
# All other branches → unchanged, KOHA_IMAGE unset
resolve_name() {
    if [[ "$1" =~ ^([0-9]+)\.([0-9]+)\.(.+)$ ]]; then
        KTD_NAME="${BASH_REMATCH[3]}${BASH_REMATCH[1]}"
        export KOHA_IMAGE="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
    else
        KTD_NAME="$1"
        unset KOHA_IMAGE
    fi
}

# Returns the DNS domain used by the Traefik proxy on this machine.
# On kohadev.home the wildcard DNS resolves *.kohadev.home; everywhere else
# fall back to *.localhost (which browsers resolve without any DNS).
_ktd_domain() {
    if getent hosts "kohadev.home" > /dev/null 2>&1; then
        echo "kohadev.home"
    else
        echo "localhost"
    fi
}

# KTD enables extensions.worktreeConfig (to give worktrees a private core.hooksPath)
# but never pairs that with a per-worktree core.bare override. Once that extension
# is on, EVERY linked worktree inherits core.bare=true from the shared bare-repo
# config instead of being treated as a normal work tree, and any command needing
# a work tree (git status, git am, git commit...) fails with "fatal: this
# operation must be run in a work tree" — regardless of cwd. Set the override
# ourselves so worktrees stay usable even if KTD's own config dance runs first.
fix_worktree_bare() {
    local worktree="$1"
    git -C "$worktree" config extensions.worktreeConfig true
    git -C "$worktree" config --worktree core.bare false
}

# Applies a bug's patches to the worktree via git bz. Exits with git bz's own
# status (e.g. 3 = a dependency is not in a followable state) so headless
# callers can tell failure modes apart.
#   $1 name  $2 worktree  $3 non_interactive (0|1)  $4 follow_status (may be empty)
apply_bz_patches() {
    local name="$1" worktree="$2" non_interactive="$3" follow_status="$4"
    local bz_num rc=0
    bz_num="$(_bz_from_name "$name")"
    if [ -z "$bz_num" ]; then
        echo "error: cannot extract bug number from '$name' (expected bug_NNNNN or qa_NNNNN form)" >&2
        exit 1
    fi
    local args=(apply)
    [ "$non_interactive" -eq 1 ] && args+=(--non-interactive)
    [ -n "$follow_status" ] && args+=(--follow-status "$follow_status")
    echo "applying bz $bz_num..."
    (cd "$worktree" && git bz "${args[@]}" "$bz_num") || rc=$?
    [ "$rc" -eq 0 ] || exit "$rc"
}

# Claude Code keys its per-project state (history, persistent memory) by the
# worktree's absolute path with / . _ collapsed to -. Point each worktree's
# memory dir at the shared root store so accumulated Koha knowledge (MEMORY.md
# et al.) follows every worktree session. Bug-specific continuation state stays
# separate in the worktree's own .remember/.
link_shared_memory() {
    local worktree="$1"
    local projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"

    local root_slug worktree_slug
    root_slug="$(printf '%s' "$KOHA_DIR"    | sed 's/[/._]/-/g')"
    worktree_slug="$(printf '%s' "$worktree" | sed 's/[/._]/-/g')"

    local shared="$projects/$root_slug/memory"
    local target="$projects/$worktree_slug/memory"

    [ -d "$shared" ] || return 0   # root store not created yet — nothing to share
    [ -L "$target" ] && return 0   # already linked
    [ -e "$target" ] && return 0   # real memory dir exists — don't clobber it

    mkdir -p "$projects/$worktree_slug"
    ln -s "$shared" "$target"
    echo "linked shared Claude memory → $target"
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_up() {
    local name="$1"; shift
    setup_env
    resolve_name "$name"

    local worktree="$KOHA_DIR/core/worktrees/$name"
    local bare="$KOHA_DIR/core/koha.git"
    local ktd_extra=()
    local plugin_path=""
    local apply_bz=0
    local bz_non_interactive=0
    local bz_follow_status=""
    local open_tmux=0
    local track_upstream=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --plugin)
                plugin_path="$(realpath "$2")"
                ktd_extra+=(--single-plugin "$plugin_path")
                shift 2 ;;
            --plugins|--selenium|--smtp|--sso|--persistent-db)
                ktd_extra+=("$1"); shift ;;
            --search-engine)
                ktd_extra+=(--search-engine "$2"); shift 2 ;;
            --bz)   apply_bz=1; shift ;;
            --non-interactive) bz_non_interactive=1; shift ;;
            --follow-status)   bz_follow_status="$2"; shift 2 ;;
            --tmux) open_tmux=1; shift ;;
            --track)
                track_upstream="$2"; shift 2 ;;
            *) echo "unknown option: $1" >&2; exit 1 ;;
        esac
    done

    if [ ! -d "$bare" ]; then
        echo "error: bare repo not found at $bare" >&2
        echo "       set KOHA_DIR or check your layout" >&2
        exit 1
    fi

    if [ ! -d "$worktree" ]; then
        if git -C "$bare" show-ref --verify --quiet "refs/heads/$name"; then
            echo "branch $name exists — checking it out as a worktree"
            git -C "$bare" worktree add "$worktree" "$name"
        else
            if [ -n "$track_upstream" ]; then
                echo "creating new branch $name tracking $track_upstream"
                git -C "$bare" worktree add "$worktree" -b "$name" "$track_upstream"
                git -C "$worktree" branch --set-upstream-to="$track_upstream" "$name"
            else
                echo "creating new branch $name from main"
                git -C "$bare" worktree add "$worktree" -b "$name" main
            fi
        fi
    fi

    # Pre-create remember plugin log dir so hooks don't error on first run in a
    # fresh worktree (the shell opens the redirect before session-start can mkdir).
    mkdir -p "$worktree/.remember/logs"
    link_shared_memory "$worktree"
    fix_worktree_bare "$worktree"

    if [ "$apply_bz" -eq 1 ]; then
        apply_bz_patches "$name" "$worktree" "$bz_non_interactive" "$bz_follow_status"
    fi

    if ! docker ps --format '{{.Names}}' | grep -q '^proxy-proxy-1$'; then
        echo "starting ktd_proxy..."
        ktd_proxy --start
    fi

    export SYNC_REPO="$worktree"
    export KTD_INSTANCE="$KTD_NAME"
    cd "$worktree"

    echo "bringing up KTD instance: $KTD_NAME"
    ktd --proxy --name "$KTD_NAME" "${ktd_extra[@]}" up -d

    local domain container ready_marker
    domain="$(_ktd_domain)"
    container="${KTD_NAME}-koha-1"
    ready_marker="koha-testing-docker has started up and is ready to be enjoyed!"

    echo ""

    # Phase 1: wait for the container to enter running state (up to 60s)
    local p1_timeout=60 p1_elapsed=0
    printf "waiting for container '%s' to start" "$container"
    while ! docker ps --filter "name=^${container}$" --filter "status=running" \
            --format '{{.Names}}' 2>/dev/null | grep -q .; do
        local cstate
        cstate=$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null)
        if [[ "$cstate" == "exited" || "$cstate" == "dead" ]]; then
            local exit_code
            exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$container" 2>/dev/null)
            printf "\nerror: container exited (code %s) — run: kd logs %s\n" \
                "${exit_code:-?}" "$name" >&2
            exit 1
        fi
        if [ "$p1_elapsed" -ge "$p1_timeout" ]; then
            printf "\ntimeout: %s did not start within %ds\n" "$container" "$p1_timeout" >&2
            exit 1
        fi
        sleep 3; p1_elapsed=$((p1_elapsed + 3)); printf "."
    done
    printf " up (%ds)\n\n" "$p1_elapsed"

    # Phase 2: stream container logs until the ready marker appears or the
    # container exits.  Process substitution (not a pipe) keeps the while loop
    # in the current shell so break returns control immediately rather than
    # waiting for docker logs --follow to exit on its own.
    local ready=0

    echo "--- KTD startup logs -----------------------------------------------"
    while IFS= read -r line; do
        printf '%s\n' "$line"
        if [[ "$line" == *"$ready_marker"* ]]; then
            ready=1
            break
        fi
    done < <(docker logs --follow "$container" 2>&1)
    echo "--------------------------------------------------------------------"
    echo ""

    if [ "$ready" -eq 0 ]; then
        local exit_code
        exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$container" 2>/dev/null)
        printf "error: container exited (code %s) — run: kd logs %s\n" \
            "${exit_code:-?}" "$name" >&2
        exit 1
    fi

    cat <<EOF
KTD instance '$KTD_NAME' is up.
  OPAC:     http://$KTD_NAME.$domain
  Staff:    http://$KTD_NAME-intra.$domain
  Worktree: $worktree
EOF
    [ -n "$plugin_path" ] && echo "  Plugin:   $plugin_path"

    if [ "$open_tmux" -eq 1 ]; then
        cmd_tmux "$name"
    fi
}

# Extracts a Bugzilla number from a branch name of the form bug_NNNNN[-suffix]
# or qa_NNNNN[-suffix].
_bz_from_name() {
    if [[ "$1" =~ ^(bug|qa)_([0-9]+) ]]; then
        echo "${BASH_REMATCH[2]}"
    fi
}

# ── bugzilla cache ───────────────────────────────────────────────────────────

_bz_cache_path() {
    echo "${XDG_CACHE_HOME:-$HOME/.cache}/kd/bugzilla.json"
}

# Fetches summary/status for the given bug numbers in one batched REST call
# and merges them into the cache. Silently leaves the cache untouched on
# failure (offline, tracker down, ...) so callers can fall back to whatever's
# already cached.
_bz_fetch_batch() {
    local ids="$1"
    [ -n "$ids" ] || return 0

    local cache
    cache="$(_bz_cache_path)"
    mkdir -p "$(dirname "$cache")"
    [ -f "$cache" ] || echo '{}' > "$cache"

    local resp
    resp="$(curl -sf --max-time 10 \
        "https://bugs.koha-community.org/bugzilla3/rest/bug?id=${ids}&include_fields=id,summary,status")" \
        || { echo "warning: could not reach Bugzilla; using cached data" >&2; return 1; }

    local fetched
    fetched="$(jq '[.bugs[] | {(.id|tostring): {status: .status, summary: .summary}}] | add // {}' <<<"$resp")" \
        || return 1

    jq --argjson fetched "$fetched" '. + $fetched' "$cache" > "$cache.tmp" \
        && mv "$cache.tmp" "$cache"
}

# Prints "id\tstatus\ttitle" for each bug number read on stdin (one per
# line), in a single jq invocation — callers should batch, not loop.
_bz_cache_get_many() {
    local cache
    cache="$(_bz_cache_path)"
    [ -s "$cache" ] || return 0
    jq -R -s -r --slurpfile c "$cache" '
        ($c[0]) as $cache
        | split("\n") | map(select(length>0))
        | map([., ($cache[.].status // ""), ($cache[.].summary // "")] | @tsv)
        | .[]'
}

cmd_wt() {
    local name="$1"; shift
    setup_env

    local worktree="$KOHA_DIR/core/worktrees/$name"
    local bare="$KOHA_DIR/core/koha.git"
    local apply_bz=0
    local bz_non_interactive=0
    local bz_follow_status=""
    local track_upstream=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --bz) apply_bz=1; shift ;;
            --non-interactive) bz_non_interactive=1; shift ;;
            --follow-status)   bz_follow_status="$2"; shift 2 ;;
            --track)
                track_upstream="$2"; shift 2 ;;
            *) echo "unknown option: $1" >&2; exit 1 ;;
        esac
    done

    if [ ! -d "$bare" ]; then
        echo "error: bare repo not found at $bare" >&2; exit 1
    fi

    if [ ! -d "$worktree" ]; then
        if git -C "$bare" show-ref --verify --quiet "refs/heads/$name"; then
            echo "branch $name exists — checking it out as a worktree"
            git -C "$bare" worktree add "$worktree" "$name"
        else
            if [ -n "$track_upstream" ]; then
                echo "creating new branch $name tracking $track_upstream"
                git -C "$bare" worktree add "$worktree" -b "$name" "$track_upstream"
                git -C "$worktree" branch --set-upstream-to="$track_upstream" "$name"
            else
                echo "creating new branch $name from main"
                git -C "$bare" worktree add "$worktree" -b "$name" main
            fi
        fi
    else
        echo "worktree already exists at $worktree"
    fi

    mkdir -p "$worktree/.remember/logs"
    link_shared_memory "$worktree"
    fix_worktree_bare "$worktree"

    if [ "$apply_bz" -eq 1 ]; then
        apply_bz_patches "$name" "$worktree" "$bz_non_interactive" "$bz_follow_status"
    fi

    echo ""
    echo "worktree ready: $worktree"
    echo "  cd $worktree"
    [ -n "$bz_num" ] || echo "  kd tmux $name   # to open a dev session"
}


cmd_down() {
    local name="$1"; shift
    setup_env
    resolve_name "$name"

    local remove_worktree="yes"
    local remove_branch="no"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --keep)    remove_worktree="no"; shift ;;
            --rm)      remove_worktree="yes"; shift ;;  # now the default; kept for compatibility
            --rm=full) remove_worktree="yes"; remove_branch="yes"; shift ;;
            *) echo "unknown option: $1" >&2; exit 1 ;;
        esac
    done

    local worktree="$KOHA_DIR/core/worktrees/$name"
    local bare="$KOHA_DIR/core/koha.git"

    echo "bringing down KTD instance: $KTD_NAME"
    ktd down "$KTD_NAME" || true

    if [ "$remove_worktree" = "yes" ] && [ -d "$worktree" ]; then
        echo "removing worktree $worktree"
        git -C "$bare" worktree remove --force "$worktree" \
            || rm -rf "$worktree"
    fi

    if [ "$remove_branch" = "yes" ]; then
        echo "deleting branch $name"
        git -C "$bare" branch -D "$name" 2>/dev/null || true
    fi

    echo "done."
}

# The tmux server's own process working directory is fixed once, forever,
# at whatever directory was current when its very first session was created
# (standard daemon behavior — nothing ever chdir()s it again). Every later
# session's `-c <dir>` is silently ignored and falls back to that frozen
# directory whenever the server's own cwd has gone stale — e.g. because a
# worktree is later removed with `kd down` while it happened to be the cwd
# that spawned the server. New panes then land in whatever that directory
# resolves to (nowhere useful) instead of the directory actually requested.
#
# Guard against ever being the session that first spawns the server from a
# worktree: make sure a session rooted at $HOME exists (idempotent — a no-op
# once the server already has one) before creating the real feature session.
# The cd matters: the server's own cwd is inherited from the launching
# process, and -c only sets the session's start dir. $HOME is never removed, so once anchored, the server's own cwd stays valid
# for its entire lifetime regardless of how many worktrees come and go.
ensure_tmux_anchor() {
    tmux has-session -t _anchor 2>/dev/null \
        || (cd "$HOME" && tmux new-session -d -s _anchor 2>/dev/null) \
        || true
}

# Attach to a session, or switch to it when already inside tmux (where a
# plain attach refuses to nest).
_tmux_enter() {
    if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "$1"
    fi
    exec tmux attach -t "$1"
}

cmd_tmux() {
    local name="$1"
    setup_env
    resolve_name "$name"

    local worktree="$KOHA_DIR/core/worktrees/$name"
    if [ ! -d "$worktree" ]; then
        echo "worktree $worktree does not exist; run: kd up $name" >&2
        exit 1
    fi

    # KD_AGENT is run through the shell (so it may carry arguments); check its
    # binary exists up front rather than letting the dev window vanish on a typo.
    local agent="${KD_AGENT:-claude}"
    if ! command -v "${agent%% *}" >/dev/null 2>&1; then
        echo "KD_AGENT command not found: ${agent%% *}" >&2
        exit 1
    fi

    ensure_tmux_anchor

    local session="koha-$KTD_NAME"
    if tmux has-session -t "$session" 2>/dev/null; then
        _tmux_enter "$session"
    fi

    # Panes inherit the tmux server's environment, not ours. The server is
    # often started by the tmux-anchor unit with a bare environment, so
    # anything the pane commands need (ktd requires KTD_HOME) must be passed
    # explicitly or 'ktd --shell' dies on the spot and its split vanishes.
    local tmux_env=(
        -e "KTD_INSTANCE=$KTD_NAME"
        -e "SYNC_REPO=$worktree"
        -e "KTD_HOME=$KTD_HOME"
        -e "KOHA_DIR=$KOHA_DIR"
    )

    # Window 1: container visibility — logs left, shell right
    tmux new-session -d -s "$session" -c "$worktree" -n "container" \
        "${tmux_env[@]}" "docker logs -f ${KTD_NAME}-koha-1"
    tmux split-window -h -t "$session:container" -c "$worktree" \
        "ktd --shell --name $KTD_NAME"
    tmux select-pane -t "$session:container.1"

    # Window 2: dev — agent left, empty term right
    tmux new-window -t "$session" -n "dev" -c "$worktree" "${tmux_env[@]}" "$agent"
    tmux split-window -h -t "$session:dev" -c "$worktree"
    tmux select-pane -t "$session:dev.1"

    tmux select-window -t "$session:dev"
    _tmux_enter "$session"
}

cmd_shell() {
    local name="$1"; shift
    setup_env
    resolve_name "$name"

    local extra=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)     extra+=(--root); shift ;;
            --run)      extra+=(--run "$2"); shift 2 ;;
            *) echo "unknown option: $1" >&2; exit 1 ;;
        esac
    done

    export SYNC_REPO="$KOHA_DIR/core/worktrees/$name"
    ktd --shell --name "$KTD_NAME" "${extra[@]}"
}

cmd_logs() {
    local name="$1"
    setup_env
    resolve_name "$name"

    export SYNC_REPO="$KOHA_DIR/core/worktrees/$name"
    ktd --logs --name "$KTD_NAME"
}

# Sorts and renders the 'kd list' data file built by cmd_list. Called both
# for the initial fzf view and, via KD_SELF, from fzf's reload bindings —
# it never re-hits docker/git/Bugzilla, just re-sorts and recolors data
# that's already on disk, so reloads stay instant.
cmd_list_render() {
    local file="$1" sort_key="${2:-branch}" sortfile="${3:-}"
    [ -f "$file" ] || { echo "error: kd list data file not found: $file" >&2; exit 1; }

    # Remember the active sort so post-action reloads can restore it.
    [ -n "$sortfile" ] && echo "$sort_key" > "$sortfile"

    local col flags
    case "$sort_key" in
        title)     col=2; flags="f"  ;;
        bz)        col=3; flags="f"  ;;
        last)      col=6; flags="nr" ;;
        container) col=5; flags="f"  ;;
        branch|*)  col=1; flags="f"  ;;
    esac

    { head -n1 "$file"
      tail -n +2 "$file" | LC_ALL=C sort -t $'\t' -k"${col},${col}${flags}"
    } | awk -F'\t' -v title_width="$KD_TITLE_WIDTH" '
        {
            for (i = 1; i <= 5; i++) {
                v = $i
                if (i == 2 && NR > 1 && length(v) > title_width) {
                    v = substr(v, 1, title_width - 1) "\xe2\x80\xa6"
                }
                cell[NR, i] = v
                if (length(v) > width[i]) width[i] = length(v)
            }
            rows = NR
        }
        END {
            reset = "\033[0m"; fgreset = "\033[39m"
            zebra = "\033[100m"; bgreset = "\033[49m"
            for (r = 1; r <= rows; r++) {
                line = ""
                for (i = 1; i <= 5; i++) {
                    v = cell[r, i]
                    seg = v
                    if (r > 1 && i == 3) {
                        color = bzcolor(v)
                        if (color != "") seg = color v fgreset
                    }
                    line = line seg pad(width[i] - length(v))
                    if (i < 5) line = line "  "
                }
                if (r > 1 && r % 2 == 0) print zebra line bgreset
                else print line
            }
        }
        function pad(n,    s) { s = ""; while (n-- > 0) s = s " "; return s }
        function bzcolor(v) {
            if (v ~ /^Pushed to/)                 return "\033[92m"
            if (v == "Passed QA")                 return "\033[32m"
            if (v == "Signed Off")                return "\033[36m"
            if (v == "Needs Signoff")              return "\033[33m"
            if (v == "Needs documenting")          return "\033[33m"
            if (v == "ASSIGNED")                  return "\033[34m"
            if (v == "Failed QA")                 return "\033[31m"
            if (v ~ /^Patch do/)                  return "\033[31m"
            if (v == "BLOCKED")                   return "\033[31m"
            if (v == "RESOLVED")                  return "\033[90m"
            return ""
        }
    '
}

# Collects branch/worktree/container/Bugzilla data and writes the full
# (untruncated, uncolored) 'kd list' table to $1; $2=1 forces a fresh
# Bugzilla lookup. Re-invoked via KD_SELF after an fzf action so the
# CONTAINER column reflects what the action just did.
cmd_list_build() {
    local datafile="$1" refresh="${2:-0}"
    setup_env
    local bare="$KOHA_DIR/core/koha.git"
    local worktree_dir="$KOHA_DIR/core/worktrees"

    [ -d "$bare" ] || { echo "error: bare repo not found at $bare" >&2; exit 1; }

    # Build worktree lookup
    declare -A wt_set
    if [ -d "$worktree_dir" ]; then
        for wt in "$worktree_dir"/*/; do
            [ -d "$wt" ] && wt_set["$(basename "$wt")"]=1
        done
    fi

    # Single docker call for every container's status, instead of one
    # 'docker ps' per worktree — this dominated runtime on repos with lots
    # of worktrees.
    declare -A docker_status
    while IFS='|' read -r cname cstatus; do
        [ -n "$cname" ] && docker_status["$cname"]="$cstatus"
    done < <(docker ps -a --format '{{.Names}}|{{.Status}}' 2>/dev/null)

    # Collect local branches up front (with committer date baked into the
    # for-each-ref call, avoiding a 'git log' per branch) so we know which
    # Bugzilla bugs to fetch. The unix timestamp is kept as a hidden sort
    # key so LAST WORKED can sort chronologically, not lexically on the
    # relative-date string.
    local branches=()
    while IFS='|' read -r branch last_worked epoch; do
        [ -n "$last_worked" ] || last_worked="-"
        [ -n "$epoch" ] || epoch=0
        branches+=("$branch|$last_worked|$epoch")
    done < <(git -C "$bare" for-each-ref \
        --sort=refname \
        --format='%(refname:short)|%(committerdate:relative)|%(committerdate:unix)' \
        refs/heads/)

    local bug_ids=() bug
    for entry in "${branches[@]}"; do
        bug="$(_bz_from_name "${entry%%|*}")"
        [ -n "$bug" ] && bug_ids+=("$bug")
    done

    if [ "${#bug_ids[@]}" -gt 0 ]; then
        if [ "$refresh" -eq 1 ]; then
            _bz_fetch_batch "$(IFS=,; echo "${bug_ids[*]}")"
        else
            local cache missing
            cache="$(_bz_cache_path)"
            if [ -s "$cache" ]; then
                missing="$(printf '%s\n' "${bug_ids[@]}" | jq -R -s -r --slurpfile c "$cache" '
                    ($c[0]) as $cache
                    | split("\n") | map(select(length>0))
                    | map(select(($cache[.]) == null))
                    | join(",")')"
            else
                missing="$(IFS=,; echo "${bug_ids[*]}")"
            fi
            [ -n "$missing" ] && _bz_fetch_batch "$missing"
        fi
    fi

    # One batched cache read for every bug id, instead of one jq call per
    # bug_/qa_ branch — this was the single biggest cost on repos with a
    # lot of in-flight bug branches.
    declare -A bz_status_map bz_title_map
    if [ "${#bug_ids[@]}" -gt 0 ]; then
        while IFS=$'\t' read -r id status title; do
            bz_status_map["$id"]="$status"
            bz_title_map["$id"]="$title"
        done < <(printf '%s\n' "${bug_ids[@]}" | _bz_cache_get_many)
    fi

    # Title truncation and coloring happen at render time so sorting always
    # operates on the real values.
    {
        printf 'BRANCH\tTITLE\tBZ\tLAST WORKED\tCONTAINER\tEPOCH\n'

        declare -A seen_local
        for entry in "${branches[@]}"; do
            IFS='|' read -r branch last_worked epoch <<<"$entry"
            seen_local["$branch"]=1

            local ktd="-"
            if [ "${wt_set[$branch]+x}" ]; then
                resolve_name "$branch"
                local cname="${KTD_NAME}-koha-1"
                if [ "${docker_status[$cname]+x}" ]; then
                    ktd="${cname} (${docker_status[$cname]})"
                else
                    ktd="(no container)"
                fi
            fi

            local bz_status bz_title
            bug="$(_bz_from_name "$branch")"
            if [ -n "$bug" ]; then
                bz_status="${bz_status_map[$bug]:-?}"
                bz_title="${bz_title_map[$bug]:-?}"
            else
                bz_status="-"
                bz_title="-"
            fi

            printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$branch" "$bz_title" "$bz_status" "$last_worked" "$ktd" "$epoch"
        done

        # Remote-only branches, folded in as ordinary rows (epoch 0 sorts
        # them to the bottom on a LAST WORKED sort) rather than a separate
        # section, since a section header doesn't survive re-sorting.
        while read -r rbranch; do
            [ "${seen_local[$rbranch]+x}" ] && continue
            printf '  origin/%s\t-\t-\t-\t(remote only)\t0\n' "$rbranch"
        done < <(git -C "$bare" for-each-ref \
            --sort=refname \
            --format='%(refname:short)' \
            refs/remotes/origin/ \
            | sed 's|^origin/||' \
            | grep -v '^HEAD$')
    } > "$datafile"
}

# Rebuilds the data file and re-renders it with the sort the user last
# picked — the reload target after every fzf action.
cmd_list_reload() {
    local datafile="$1" sortfile="$2"
    cmd_list_build "$datafile" 0
    cmd_list_render "$datafile" "$(cat "$sortfile" 2>/dev/null || echo branch)" "$sortfile"
}

# Runs one action against the branch names fzf hands over (column 1 of each
# selected row; remote-only rows arrive as 'origin/<branch>'). Each action
# runs in a subshell so a die-on-error inside cmd_* can't tear down the
# list, and failures pause so the message survives fzf's redraw.
cmd_list_act() {
    local action="$1"; shift
    [ $# -gt 0 ] || return 0

    case "$action" in
        tmux|shell|logs) set -- "$1" ;;  # single-target actions
        down|down-full)
            local what="stop KTD and remove the worktree for"
            [ "$action" = down-full ] && what="stop KTD, remove the worktree AND DELETE THE BRANCH of"
            printf 'kd %s: %s: %s\nProceed? [y/N] ' "$action" "$what" "$*"
            local answer; read -r answer
            [[ "$answer" =~ ^[Yy] ]] || return 0 ;;
    esac

    local row name rc
    local track
    for row in "$@"; do
        name="${row#origin/}"
        track=()
        [[ "$row" == origin/* ]] && track=(--track "$row")

        set +e
        (
            case "$action" in
                tmux)      cmd_tmux "$name" ;;
                up)        cmd_up "$name" --tmux "${track[@]}" ;;
                up-notmux) cmd_up "$name" "${track[@]}" ;;
                wt)        cmd_wt "$name" "${track[@]}" ;;
                shell)     cmd_shell "$name" ;;
                logs)      cmd_logs "$name" ;;
                down)      cmd_down "$name" ;;
                down-full) cmd_down "$name" --rm=full ;;
                *) echo "unknown action: $action" >&2; exit 1 ;;
            esac
        )
        rc=$?
        set -e

        if [ "$rc" -ne 0 ]; then
            printf '\nkd %s %s failed (exit %s) — press enter to continue ' "$action" "$name" "$rc"
            read -r _
        fi
    done
}

# Action menu for the selected row(s), offering only what makes sense for
# their state. Several rows → just the bulk-capable up/down actions.
cmd_list_menu() {
    [ $# -gt 0 ] || return 0
    setup_env

    local entries title
    if [ $# -gt 1 ]; then
        title="$# branches"
        entries=$'up-notmux\tup (start KTD, no tmux)\ndown\tdown (stop KTD, remove worktree)\ndown-full\tdown --rm=full (also delete branch)'
    else
        title="$1"
        local name="${1#origin/}"
        resolve_name "$name"
        local state
        if [[ "$1" == origin/* ]]; then
            state=remote
        elif [ ! -d "$KOHA_DIR/core/worktrees/$name" ]; then
            state=nowt
        elif docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "${KTD_NAME}-koha-1"; then
            state=running
        else
            state=stopped
        fi

        local up=$'up\tup (worktree + KTD + tmux)'
        local up_nt=$'up-notmux\tup (start KTD, no tmux)'
        local wt=$'wt\twt (worktree only)'
        local tmux_e=$'tmux\ttmux (attach/create session)'
        local shell_e=$'shell\tshell (KTD container)'
        local logs_e=$'logs\tlogs (follow container)'
        local down=$'down\tdown (stop KTD, remove worktree)'
        local down_f=$'down-full\tdown --rm=full (also delete branch)'
        case "$state" in
            remote)  entries="$up"$'\n'"$up_nt"$'\n'"$wt" ;;
            nowt)    entries="$up"$'\n'"$up_nt"$'\n'"$wt"$'\n'"$down_f" ;;
            stopped) entries="$up"$'\n'"$up_nt"$'\n'"$tmux_e"$'\n'"$down"$'\n'"$down_f" ;;
            running) entries="$tmux_e"$'\n'"$shell_e"$'\n'"$logs_e"$'\n'"$down"$'\n'"$down_f" ;;
        esac
    fi

    local choice
    choice="$(printf '%s\n' "$entries" \
        | fzf --delimiter=$'\t' --with-nth=2 --prompt="$title> " \
              --height=~12 --reverse --no-sort --cycle)" || return 0
    cmd_list_act "${choice%%$'\t'*}" "$@"
}

cmd_list() {
    setup_env
    local refresh=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --refresh) refresh=1; shift ;;
            *) echo "unknown option: $1" >&2; exit 1 ;;
        esac
    done

    local pager=(${PAGER:-less -FRSX})

    # Best-effort sweep of stale data files from earlier runs that didn't
    # clean up after themselves — e.g. 'kd list | head' closes the pipe
    # early, SIGPIPE kills the pager mid-stream, and under 'set -e' bash
    # can bypass the EXIT trap below entirely rather than running it.
    find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'kd-list.*' -mmin +60 -delete 2>/dev/null || true

    local datafile sortfile
    datafile="$(mktemp "${TMPDIR:-/tmp}/kd-list.XXXXXX")"
    sortfile="$(mktemp "${TMPDIR:-/tmp}/kd-list.XXXXXX")"
    trap "rm -f '$datafile' '$sortfile'" EXIT

    cmd_list_build "$datafile" "$refresh"

    if command -v fzf >/dev/null 2>&1 && [ -t 1 ]; then
        local reload="reload($KD_SELF _list_reload $datafile $sortfile)"
        fzf --ansi --exact --no-sort --multi --header-lines=1 \
            --header=$'enter:actions  tab:select  ctrl-t:tmux  ctrl-u:up+tmux  ctrl-d:down\nalt-t:title  alt-b:bz  alt-l:last-worked  alt-c:container  alt-r:branch (reset)' \
            --bind "alt-t:reload($KD_SELF _list_render $datafile title $sortfile)" \
            --bind "alt-b:reload($KD_SELF _list_render $datafile bz $sortfile)" \
            --bind "alt-l:reload($KD_SELF _list_render $datafile last $sortfile)" \
            --bind "alt-c:reload($KD_SELF _list_render $datafile container $sortfile)" \
            --bind "alt-r:reload($KD_SELF _list_render $datafile branch $sortfile)" \
            --bind "enter:execute($KD_SELF _list_menu {+1})+$reload" \
            --bind "ctrl-t:execute($KD_SELF _list_act tmux {1})+$reload" \
            --bind "ctrl-u:execute($KD_SELF _list_act up {+1})+$reload" \
            --bind "ctrl-d:execute($KD_SELF _list_act down {+1})+$reload" \
            < <(cmd_list_render "$datafile" branch "$sortfile")
    else
        cmd_list_render "$datafile" branch | "${pager[@]}"
    fi
}

cmd_proxy() {
    setup_env
    case "${1:-status}" in
        start)  ktd_proxy --start ;;
        stop)   ktd_proxy --stop ;;
        status) ktd_proxy --status ;;
        *) echo "usage: kd proxy [start|stop|status]" >&2; exit 1 ;;
    esac
}

# ── prune ─────────────────────────────────────────────────────────────────────

# True if any process has its cwd inside $1 (a shell, editor, agent session...).
# Removing a directory under a live process leaves it with a dead cwd, so
# prune never touches these.
_wt_in_use() {
    local dir="$1" p cwd
    if [ -d /proc/self ]; then
        for p in /proc/[0-9]*; do
            cwd="$(readlink "$p/cwd" 2>/dev/null)" || continue
            case "$cwd" in "$dir"|"$dir"/*) return 0 ;; esac
        done
        return 1
    fi
    lsof -d cwd -Fn 2>/dev/null | grep -qF "n$dir"
}

# Unix time of the worktree's last activity: the newer of its HEAD commit and
# its index (touched by status, add, am, checkout...).
_wt_last_activity() {
    local wt="$1" gd commit idx
    gd="$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null)" || { echo 0; return; }
    commit="$(git -C "$wt" log -1 --format=%ct 2>/dev/null || echo 0)"
    idx="$(stat -c %Y "$gd/index" 2>/dev/null || stat -f %m "$gd/index" 2>/dev/null || echo 0)"
    echo $(( commit > idx ? commit : idx ))
}

# KTD compose project name for a worktree/branch name.
_ktd_name_for() {
    ( resolve_name "$1"; echo "$KTD_NAME" )
}

# Removes every container (and anonymous volume) and network of a compose
# project. Named volumes are left alone: --persistent-db keeps its data in one
# on purpose.
_prune_rm_project() {
    local project="$1" ids
    ids="$(docker ps -aq --filter "label=com.docker.compose.project=$project" 2>/dev/null)"
    [ -z "$ids" ] || docker rm -f -v $ids >/dev/null 2>&1 || true
    ids="$(docker network ls -q --filter "label=com.docker.compose.project=$project" 2>/dev/null)"
    [ -z "$ids" ] || docker network rm $ids >/dev/null 2>&1 || true
}

# Classifies one worktree. Prints "<verdict>|<reason>" where verdict is one of
#   remove       clean and idle
#   remove-am    abandoned half-applied 'git am' (aborted first, then removed)
#   keep         anything else; the reason says why
# $1 worktree path  $2 name  $3 min idle days  $4 name of the running-containers set
_prune_classify() {
    local wt="$1" name="$2" days="$3" running="$4"
    local gd status rc idle_days stuck_am=0 ktd f
    local -n _running="$running"

    if _wt_in_use "$wt"; then echo "keep|in use by a running process"; return; fi

    ktd="$(_ktd_name_for "$name")"
    if [ -n "${_running[$ktd-koha-1]:-}" ]; then echo "keep|KTD instance is running"; return; fi

    gd="$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null)" \
        || { echo "keep|not a usable git worktree"; return; }

    # A detached HEAD whose commits no branch/tag/remote points at would be
    # lost with the worktree.
    if ! git -C "$wt" symbolic-ref -q HEAD >/dev/null 2>&1; then
        if [ "$(git -C "$wt" rev-list --count HEAD --not --branches --remotes --tags 2>/dev/null || echo 1)" != 0 ]; then
            echo "keep|detached HEAD with commits no branch points at"; return
        fi
    fi

    if [ -d "$gd/rebase-merge" ]; then echo "keep|rebase in progress"; return; fi
    if [ -d "$gd/rebase-apply" ]; then
        if [ -e "$gd/rebase-apply/applying" ]; then
            stuck_am=1
        else
            echo "keep|rebase in progress"; return
        fi
    fi
    for f in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
        [ -e "$gd/$f" ] && { echo "keep|${f%_HEAD} in progress"; return; }
    done

    idle_days=$(( ( $(date +%s) - $(_wt_last_activity "$wt") ) / 86400 ))
    if [ "$idle_days" -lt "$days" ]; then echo "keep|active ${idle_days}d ago (< ${days}d)"; return; fi

    # --no-optional-locks: status must not write the index (it also fails when
    # the disk is full, which must read as "unknown", never as "clean").
    rc=0
    status="$(git --no-optional-locks -C "$wt" status --porcelain 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then echo "keep|git status failed"; return; fi

    if [ "$stuck_am" -eq 1 ]; then
        # The conflicted/staged state is the am's own; anything untracked
        # survives the abort and is caught by the non-forced remove later.
        echo "remove-am|abandoned git am, idle ${idle_days}d"; return
    fi
    if [ -n "$status" ]; then
        echo "keep|$(printf '%s\n' "$status" | wc -l | tr -d ' ') uncommitted change(s)"; return
    fi
    echo "remove|clean, idle ${idle_days}d"
}

cmd_prune() {
    local days=7 yes=0 dry=0 containers=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --older-than)    days="${2:?--older-than needs a number of days}"; shift 2 ;;
            --older-than=*)  days="${1#*=}"; shift ;;
            -y|--yes)        yes=1; shift ;;
            -n|--dry-run)    dry=1; shift ;;
            --no-containers) containers=0; shift ;;
            *) echo "usage: kd prune [--older-than DAYS] [--no-containers] [-n|--dry-run] [-y|--yes]" >&2; exit 1 ;;
        esac
    done
    [[ "$days" =~ ^[0-9]+$ ]] || { echo "error: --older-than must be a whole number of days" >&2; exit 1; }

    setup_env
    local bare="$KOHA_DIR/core/koha.git"
    local worktree_dir="$KOHA_DIR/core/worktrees"
    [ -d "$bare" ] || { echo "error: bare repo not found at $bare" >&2; exit 1; }

    git -C "$bare" worktree prune   # drop entries whose directory is already gone

    declare -A running_set=() registered=() expected_projects=()
    local cname
    while IFS= read -r cname; do
        [ -n "$cname" ] && running_set["$cname"]=1
    done < <(docker ps --format '{{.Names}}' 2>/dev/null)

    local wt name
    while IFS= read -r wt; do
        [ -n "$wt" ] && registered["$wt"]=1
    done < <(git -C "$bare" worktree list --porcelain | sed -n 's/^worktree //p')

    # ── worktrees ──
    local plan_rm=() plan_am=() verdict reason kb total_kb=0
    local -a keep_lines=() rm_lines=() stray=() stray_empty=()
    if [ -d "$worktree_dir" ]; then
        for wt in "$worktree_dir"/*/; do
            wt="${wt%/}"; [ -d "$wt" ] || continue
            name="$(basename "$wt")"
            expected_projects["$(_ktd_name_for "$name")"]=1
            if [ -z "${registered[$wt]:-}" ]; then
                # A session's hooks can recreate .remember/ after the worktree
                # is gone; that alone is not worth reporting, just sweep it.
                if [ "$(ls -A "$wt" 2>/dev/null)" = ".remember" ] && [ -O "$wt" ]; then
                    stray_empty+=("$name")
                else
                    stray+=("$name")
                fi
                continue
            fi
            IFS='|' read -r verdict reason < <(_prune_classify "$wt" "$name" "$days" running_set)
            case "$verdict" in
                remove|remove-am)
                    kb="$(du -sk "$wt" 2>/dev/null | cut -f1)"; total_kb=$(( total_kb + ${kb:-0} ))
                    [ "$verdict" = remove ] && plan_rm+=("$name") || plan_am+=("$name")
                    rm_lines+=("$(printf '  remove  %-28s %6s MB  %s' "$name" "$(( ${kb:-0} / 1024 ))" "$reason")") ;;
                *) keep_lines+=("$(printf '  keep    %-28s %s' "$name" "$reason")") ;;
            esac
        done
    fi

    # ── orphaned KTD instances (compose projects with no worktree) ──
    # Only projects started from $KTD_HOME itself count, which excludes the
    # shared proxy (KTD_HOME/proxy) and unrelated stacks.
    local -a orphans=() orphan_lines=()
    if [ "$containers" -eq 1 ]; then
        local project wdir n_ctr
        while IFS='|' read -r project wdir; do
            [ -n "$project" ] && [ "$wdir" = "$KTD_HOME" ] || continue
            [ -z "${expected_projects[$project]:-}" ] || continue
            if [ -n "${running_set[$project-koha-1]:-}" ]; then continue; fi   # something is serving it
            n_ctr="$(docker ps -aq --filter "label=com.docker.compose.project=$project" | wc -l | tr -d ' ')"
            orphans+=("$project")
            orphan_lines+=("$(printf '  remove  %-28s %s container(s), no worktree' "$project" "$n_ctr")")
        done < <(docker ps -a --format '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null | sort -u)
    fi

    echo "Worktrees ($worktree_dir), idle threshold ${days}d; branches are never deleted:"
    [ "${#rm_lines[@]}" -eq 0 ] || printf '%s\n' "${rm_lines[@]}"
    [ "${#keep_lines[@]}" -eq 0 ] || printf '%s\n' "${keep_lines[@]}"
    [ "${#rm_lines[@]}" -gt 0 ] || [ "${#keep_lines[@]}" -gt 0 ] || echo "  (none)"
    if [ "${#stray[@]}" -gt 0 ]; then
        echo
        echo "Directories that are no longer registered worktrees (remove by hand; may need sudo"
        echo "if a container created root-owned files, e.g. node_modules):"
        printf '  stray   %s\n' "${stray[@]}"
    fi
    if [ "$containers" -eq 1 ]; then
        echo
        echo "Orphaned KTD instances (named volumes, e.g. --persistent-db, are kept):"
        if [ "${#orphan_lines[@]}" -gt 0 ]; then printf '%s\n' "${orphan_lines[@]}"; else echo "  (none)"; fi
    fi
    echo
    echo "Would remove: $(( ${#plan_rm[@]} + ${#plan_am[@]} )) worktree(s) (~$(( total_kb / 1024 )) MB), ${#orphans[@]} orphaned instance(s)," \
         "${#stray_empty[@]} leftover .remember-only dir(s)."

    if [ $(( ${#plan_rm[@]} + ${#plan_am[@]} + ${#orphans[@]} + ${#stray_empty[@]} )) -eq 0 ]; then return 0; fi
    [ "$dry" -eq 0 ] || return 0
    if [ "$yes" -eq 0 ]; then
        if [ -t 0 ]; then
            local reply; read -r -p "Proceed? [y/N] " reply
            [[ "$reply" =~ ^[Yy]$ ]] || { echo "aborted."; return 0; }
        else
            echo "not a terminal: pass --yes to proceed (nothing removed)."; return 0
        fi
    fi

    local failed=0
    for name in "${plan_am[@]}" "${plan_rm[@]}"; do
        wt="$worktree_dir/$name"
        if printf '%s\n' "${plan_am[@]}" | grep -qxF "$name"; then
            git -C "$wt" am --abort >/dev/null 2>&1 \
                || { echo "  skipped $name: git am --abort failed"; failed=1; continue; }
        fi
        # Not --force: if anything untracked is left, git refuses and we keep it.
        if git -C "$bare" worktree remove "$wt" 2>/dev/null; then
            ktd down "$(_ktd_name_for "$name")" >/dev/null 2>&1 || true
            _prune_rm_project "$(_ktd_name_for "$name")"
            echo "  removed $name"
        else
            echo "  skipped $name: not clean after all (untracked files?) — left in place"; failed=1
        fi
    done
    for project in "${orphans[@]}"; do
        _prune_rm_project "$project"
        echo "  removed instance $project"
    done
    for name in "${stray_empty[@]}"; do
        rm -rf "${worktree_dir:?}/${name:?}" && echo "  removed leftover dir $name"
    done
    [ "$failed" -eq 0 ] || echo "some worktrees were skipped; see above."
    echo "done."
}

# ── dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-}"
[ $# -gt 0 ] && shift

case "$CMD" in
    up)       [ -n "$1" ] || { echo "usage: kd up <name> [options]" >&2; exit 1; }
              cmd_up "$@" ;;
    wt)       [ -n "$1" ] || { echo "usage: kd wt <name> [--bz NUM]" >&2; exit 1; }
              cmd_wt "$@" ;;
    down)     [ -n "$1" ] || { echo "usage: kd down <name> [--keep] [--rm=full]" >&2; exit 1; }
              cmd_down "$@" ;;
    tmux)     [ -n "$1" ] || { echo "usage: kd tmux <name>" >&2; exit 1; }
              cmd_tmux "$@" ;;
    shell)    [ -n "$1" ] || { echo "usage: kd shell <name> [--root] [--run 'cmd']" >&2; exit 1; }
              cmd_shell "$@" ;;
    logs)     [ -n "$1" ] || { echo "usage: kd logs <name>" >&2; exit 1; }
              cmd_logs "$@" ;;
    list|branches|br) cmd_list "$@" ;;
    prune)    cmd_prune "$@" ;;
    # internal: used by kd list's fzf bindings
    _list_render) cmd_list_render "$@" ;;
    _list_build)  cmd_list_build "$@" ;;
    _list_reload) cmd_list_reload "$@" ;;
    _list_menu)   cmd_list_menu "$@" ;;
    _list_act)    cmd_list_act "$@" ;;
    proxy)    cmd_proxy "$@" ;;
    -h|--help) usage ;;
    "") usage; exit 1 ;;
    *) echo "unknown command: $CMD" >&2; usage; exit 1 ;;
esac
